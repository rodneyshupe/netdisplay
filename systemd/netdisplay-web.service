[Unit]
Description=netdisplay: web dashboard and JSON API
After=network-online.target
Wants=network-online.target

[Service]
Environment=NETDISPLAY_CONFIG=/etc/netdisplay/config.yaml
EnvironmentFile=-/etc/netdisplay/env
ExecStart=/usr/local/bin/netdisplay serve
Restart=always
RestartSec=5
# Unprivileged; only allowed to bind a low port such as 80.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
