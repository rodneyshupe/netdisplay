[Unit]
Description=netdisplay: dashboard on the LCD
After=network-online.target
Wants=network-online.target

[Service]
Environment=NETDISPLAY_CONFIG=/etc/netdisplay/config.yaml
# Stop the console cursor blinking over the dashboard (harmless if there is no fbcon)
ExecStartPre=-/bin/sh -c 'echo 0 > /sys/class/graphics/fbcon/cursor_blink'
ExecStart=/usr/local/bin/netdisplay run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
